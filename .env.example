# Variables del HR Assistant con sus valores por omision.
# El producto NO lee este archivo ni un .env: solo lee variables de entorno.
# Si lo copias como .env, cargalo en la terminal antes de arrancar (bash):
#   set -a; . ./.env; set +a
# Nunca subas el .env al repositorio: los secretos van vacios en este ejemplo.

# Modelo: fake (simulado, sin red) o gateway (Workers AI por AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway; el token es secreto)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Produccion y acceso
# development o production; con production se aplican las reglas de compliance
# (ver doc/compliance-checklist.md) y el producto no arranca si alguna falla.
ENVIRONMENT=development
# Clientes y claves (secreto): cliente:clave,cliente2:clave2
# En produccion cada clave debe tener 16 caracteres o mas.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Borradores de factura (POST /invoice)
CLIENTES_PATH=data/clientes.json
CONCEPTOS_PATH=data/conceptos.json
MAX_INVOICE_LINES=5
MAX_LINE_QUANTITY=1000
# Enmascara PII antes del modelo; en produccion debe ser true o no arranca.
PII_MASKING=true
